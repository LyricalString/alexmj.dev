---
import Base from "../../layouts/Base.astro";
import Link from "../../components/Link.astro";
import Section from "../../components/Section.astro";
import Brand from "../../components/Brand.astro";
---

<Base
  title="Copy Trader — Multi-exchange copy trading engine | Alejandro Martínez"
  description="Built a multi-exchange copy trading system in Rust: copies trades from a master Bybit account to follower accounts on Bybit, Binance, and Hyperliquid in real-time via WebSocket streams. Position-based math, BigDecimal precision, idempotent execution."
>
  <div class="page">

    <!-- top bar -->
    <header class="topbar">
      <Brand />
      <nav class="topbar-nav">
        <Link href="/">← back</Link>
        <Link href="/#case-studies">case studies</Link>
        <Link href="mailto:alex@konar.es">contact</Link>
      </nav>
    </header>

    <!-- hero -->
    <div class="hero">
      <div class="hero-grid">
        <div class="hero-tag">CASE STUDY · 07</div>
        <div class="hero-main">
          <div class="hero-meta">COPY TRADING INFRASTRUCTURE &nbsp;·&nbsp; 2024 — 2025 &nbsp;·&nbsp; SOLE ENGINEER</div>
          <h1 class="hero-h1">A multi-exchange copy trading engine built in Rust.</h1>
          <p class="hero-lead">
            Copy Trader is the real-time copy trading engine behind Autowealth. It copies trades from
            a master Bybit account to follower accounts across Bybit, Binance, and Hyperliquid via
            WebSocket streams. Position-based quantity math with BigDecimal precision, idempotent
            execution, and smart reduction fallback when orders fail. Deployed on AWS via CDK.
          </p>
        </div>
        <div class="hero-links">
          <div class="hero-links-label">LINKS</div>
          <Link href="https://autowealth.trade" class="hero-link">autowealth.trade ↗</Link>
        </div>
      </div>
    </div>

    <!-- numbers strip -->
    <div class="numbers">
      <div class="numbers-cell">
        <div class="numbers-key">EXCHANGES</div>
        <div class="numbers-val">3</div>
        <div class="numbers-sub">bybit · binance · hyperliquid</div>
      </div>
      <div class="numbers-cell">
        <div class="numbers-key">MASTER</div>
        <div class="numbers-val">bybit</div>
        <div class="numbers-sub">only exchange with master role</div>
      </div>
      <div class="numbers-cell">
        <div class="numbers-key">PRECISION</div>
        <div class="numbers-val">BigDecimal</div>
        <div class="numbers-sub">no floating-point in financial math</div>
      </div>
      <div class="numbers-cell">
        <div class="numbers-key">LATENCY</div>
        <div class="numbers-val">real-time</div>
        <div class="numbers-sub">WebSocket streams, no polling</div>
      </div>
      <div class="numbers-cell">
        <div class="numbers-key">INFRA</div>
        <div class="numbers-val">AWS</div>
        <div class="numbers-sub">CDK · Docker · CloudWatch</div>
      </div>
      <div class="numbers-cell numbers-cell--last">
        <div class="numbers-key">NOTIFICATIONS</div>
        <div class="numbers-val">3</div>
        <div class="numbers-sub">telegram · sms · dashboard</div>
      </div>
    </div>

    <!-- the brief -->
    <Section tag="THE BRIEF" title="Copy trading that doesn't lose money on rounding errors.">
      <p class="body-para">
        Copy trading sounds simple: master opens a position, followers open the same position.
        The reality is much harder. Each follower has a different margin, different leverage, and
        different position sizes. A naive ratio-based approach breaks on partial closes, leverage
        mismatches, and exchange precision requirements. Copy Trader solves this with position-based
        math: calculate follower quantity from their current position relative to the master's,
        not from a fixed ratio. The result is proportional exposure that survives partial closes,
        leverage changes, and exchange-specific lot size constraints.
      </p>
    </Section>

    <!-- architecture -->
    <Section tag="ARCHITECTURE" title="Master → WebSocket → position cache → parallel follower execution.">
      <pre class="arch-diagram">  ┌─ master account (Bybit only)
  │      WebSocket stream → position events
  │
  ├──▶ pending_orders_cache     [ in-memory · until position event arrives ]
  │
  ├──▶ position_event_handler   [ classify: open · increase · partial_close · full_close ]
  │
  ├──▶ quantity_calculator      [ position-based math · BigDecimal · no f64 ]
  │      opens:   qty = master_qty × (follower_margin / master_im)
  │      reduces: qty = follower_position × reduction_pct
  │      rounding: down for opens (under-expose), up for closes (avoid residuals)
  │
  ├──▶ follower_executor        [ parallel per-follower · ExchangeClient trait ]
  │      ├── leverage_sync      [ block opens on failure ]
  │      ├── validate           [ precision · min/max · notional ]
  │      ├── smart_reduction    [ fallback if order fails ]
  │      └── execute            [ idempotency check via DB ]
  │
  └──▶ notification_pipeline    [ telegram bot · twilio sms · dashboard push ]
</pre>
    </Section>

    <!-- decisions -->
    <Section tag="DECISIONS" title="Six calls that define the system.">
      <div class="decisions-grid">
        <div class="decision">
          <div class="decision-tag">01 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">Position-based math over ratio-based</div>
          <p class="decision-body">A fixed ratio (follower_margin / master_margin) breaks on partial closes and leverage changes. Position-based math calculates each follower's quantity from their current position relative to the master's, so exposure stays proportional regardless of partial closes, leverage adjustments, or margin changes. The formula: follower_qty = master_qty × (follower_margin / master_position_im).</p>
        </div>
        <div class="decision">
          <div class="decision-tag">02 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">BigDecimal for all financial calculations</div>
          <p class="decision-body">Floating-point arithmetic introduces rounding errors that compound across trades. Every financial calculation uses BigDecimal — never f64. This eliminates the class of bugs where a follower ends up with 0.0001 BTC more or less than expected, which on high-frequency copy trading can mean the difference between profit and loss.</p>
        </div>
        <div class="decision">
          <div class="decision-tag">03 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">Bybit as master-only, Binance/Hyperliquid follower-only</div>
          <p class="decision-body">Bybit's WebSocket API and REST endpoints are the most reliable for master account monitoring. Binance and Hyperliquid are follower-only (they receive copies but never act as masters). This asymmetry simplifies the architecture: one master stream, multiple follower execution paths, each with exchange-specific order mapping and precision rules.</p>
        </div>
        <div class="decision">
          <div class="decision-tag">04 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">Idempotent execution via database</div>
          <p class="decision-body">Network retries and WebSocket reconnections can cause duplicate trade events. Every execution is checked against a database idempotency key before placing an order. This prevents double-trading when a follower receives the same position event twice due to a reconnection or race condition.</p>
        </div>
        <div class="decision">
          <div class="decision-tag">05 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">Smart reduction fallback</div>
          <p class="decision-body">If a follower's order fails (insufficient margin, exchange rejection, precision mismatch), the system doesn't abort the entire copy operation. Instead, it attempts a reduced quantity that satisfies the exchange's constraints. This keeps followers partially exposed rather than completely missing the trade.</p>
        </div>
        <div class="decision">
          <div class="decision-tag">06 &nbsp;·&nbsp; DECISION</div>
          <div class="decision-title">Rust over Python/Node for the core engine</div>
          <p class="decision-body">Copy trading is latency-sensitive and correctness-critical. Rust's compile-time guarantees eliminate entire classes of bugs (null pointer, data races) and its performance means WebSocket events are processed in microseconds, not milliseconds. The Next.js dashboard handles the UI, but the core copy pipeline is pure Rust with Axum for the API layer.</p>
        </div>
      </div>
    </Section>

    <!-- ownership -->
    <Section tag="OWNERSHIP" title="The full stack: Rust backend, Next.js dashboard, AWS CDK infra.">
      <div class="ownership">
        <div class="ownership-header">
          <span>COMPONENT</span>
          <span>STACK</span>
          <span class="text-right">ROLE</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">Rust backend (Axum)</span>
          <span class="ownership-dim">rust · axum · tokio · diesel · postgresql</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">WebSocket pipeline</span>
          <span class="ownership-dim">rust · bybit ws · binance ws · hyperliquid ws</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">Trade execution engine</span>
          <span class="ownership-dim">rust · position math · BigDecimal · idempotency</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">Next.js dashboard</span>
          <span class="ownership-dim">next.js 14 · shadcn/ui · react query · clerk auth</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">AWS CDK infrastructure</span>
          <span class="ownership-dim">typescript · aws cdk · docker · cloudwatch</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
        <div class="ownership-row">
          <span class="ownership-repo">Notification system</span>
          <span class="ownership-dim">telegram bot · twilio sms · dashboard push</span>
          <span class="ownership-dim text-right">sole</span>
        </div>
      </div>
    </Section>

    <!-- outcome -->
    <Section tag="OUTCOME" title="A production copy trading engine that handles real money.">
      <p class="body-para">
        Copy Trader is the engine that makes Autowealth's CompoundFox strategy accessible to
        followers. It handles the complex math of proportional position sizing across three
        different exchanges, each with their own precision requirements and order formats. The
        position-based approach ensures followers stay proportionally exposed regardless of their
        margin size, leverage, or partial close history. BigDecimal precision eliminates rounding
        errors that would otherwise accumulate across hundreds of trades. Idempotent execution
        and smart reduction fallback keep the system resilient to network failures and exchange
        rejections.
      </p>
    </Section>

    <!-- next case -->
    <div class="next-case">
      <span class="next-case-label">NEXT CASE STUDY</span>
      <Link href="/cases/trilo" class="next-case-link">
        01 &nbsp; Trilo — AI workspace with autonomous coworkers →
      </Link>
    </div>

    <!-- footer -->
    <footer class="footer">
      <span>alejandro martinez · @lyricalstring · oss under konar technologies</span>
      <span>alex@konar.es</span>
    </footer>

  </div>
</Base>

<style>
  .page {
    max-width: 1280px;
    padding: 28px 32px 56px;
    box-sizing: border-box;
    margin: 0 auto;
  }

  /* ── TOP BAR ── */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    letter-spacing: 0.04em;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }

  .topbar-left {
    display: flex;
    gap: 14px;
  }

  .topbar-nav {
    display: flex;
    gap: 28px;
  }

  /* ── HERO ── */
  .hero {
    padding-top: 88px;
    padding-bottom: 80px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 180px 1fr 280px;
    gap: 32px;
    align-items: baseline;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    letter-spacing: 0.04em;
  }

  .hero-h1 {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin: 20px 0 0;
    max-width: 880px;
    text-wrap: pretty;
  }

  .hero-lead {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--dim);
    line-height: 1.55;
    margin-top: 24px;
    max-width: 680px;
    text-wrap: pretty;
  }

  .hero-links {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
    line-height: 1.7;
  }

  .hero-links-label {
    color: var(--faint);
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .hero-link {
    display: block;
    color: var(--fg);
  }

  /* ── NUMBERS STRIP ── */
  .numbers {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .numbers-cell {
    padding: 24px 16px;
    border-right: 1px solid var(--rule);
  }

  .numbers-cell--last {
    border-right: none;
  }

  .numbers-key {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.1em;
  }

  .numbers-val {
    font-family: var(--font-sans);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 6px;
  }

  .numbers-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--faint);
    margin-top: 4px;
  }

  /* ── BODY PARA (brief + outcome) ── */
  .body-para {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--dim);
    line-height: 1.65;
    max-width: 640px;
    text-wrap: pretty;
    margin: 0;
  }

  /* ── ARCHITECTURE DIAGRAM ── */
  .arch-diagram {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    line-height: 1.85;
    background: #101216;
    border: 1px solid var(--rule);
    padding: 24px 28px;
    max-width: 760px;
    white-space: pre;
    overflow-x: auto;
    margin: 0;
  }

  /* ── DECISIONS ── */
  .decisions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 56px;
    max-width: 920px;
  }

  .decision-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }

  .decision-title {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .decision-body {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--dim);
    line-height: 1.6;
    margin-top: 8px;
    text-wrap: pretty;
  }

  /* ── OWNERSHIP TABLE ── */
  .ownership {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    max-width: 820px;
  }

  .ownership-header {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--faint);
    letter-spacing: 0.06em;
    font-size: 11px;
  }

  .ownership-row {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .ownership-repo {
    color: var(--fg);
  }

  .ownership-dim {
    color: var(--dim);
  }

  .text-right {
    text-align: right;
  }

  /* ── NEXT CASE ── */
  .next-case {
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .next-case-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .next-case-link {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--fg);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .next-case-link:hover {
    color: var(--accent);
  }

  /* ── FOOTER ── */
  .footer {
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
</style>
