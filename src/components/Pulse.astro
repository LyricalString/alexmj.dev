---
interface Props {
  color?: string;
  size?: string;
}

const { color = "var(--accent)", size = "6px" } = Astro.props;
---

<span
  class="pulse"
  style={`--pulse-color: ${color}; --pulse-size: ${size};`}
  aria-hidden="true"
></span>

<style>
  .pulse {
    display: inline-block;
    width: var(--pulse-size);
    height: var(--pulse-size);
    border-radius: 50%;
    background-color: var(--pulse-color);
    animation: pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.85);
      opacity: 0.45;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
