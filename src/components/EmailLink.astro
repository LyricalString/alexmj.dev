---
interface Props {
  class?: string;
  as?: "link" | "text";
  withArrow?: boolean;
}
const { class: className, as = "link", withArrow = false } = Astro.props;
const hasSlot = Astro.slots.has("default");
const email = "alex@konar.es";
const fallback = `${email}${withArrow ? " →" : ""}`;
---

{as === "link" ? (
  <a class:list={["link", "email-anchor", className]} href={`mailto:${email}`}>
    {hasSlot ? <slot /> : fallback}
  </a>
) : (
  <span class:list={[className]}>{fallback}</span>
)}

<style>
  .link {
    color: inherit;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .link:hover {
    color: var(--accent);
  }
</style>
