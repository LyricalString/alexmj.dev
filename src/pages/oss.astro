---
import Brand from "../components/Brand.astro";
import Link from "../components/Link.astro";
import Base from "../layouts/Base.astro";
import { getLeyAbiertaStats } from "../lib/leyabierta-stats";

const { laws, commits } = await getLeyAbiertaStats();
---

<Base
  title="Open Source — Alejandro Martínez"
  description="Tools and infrastructure published under Konar Technologies and personal repos. AGPL/MIT/Apache where it makes sense."
>
  <div class="page">

    <!-- ── TOP BAR ──────────────────────────────────────────────────── -->
    <header class="topbar">
      <Brand />
      <nav class="nav">
        <Link href="/">home</Link>
        <Link href="/projects">projects</Link>
        <Link href="/about">about</Link>
        <Link href="/cv">cv</Link>
      </nav>
    </header>

    <!-- ── HERO ────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero-tag">OPEN SOURCE</div>
      <h1 class="hero-h1">Code in the open.</h1>
      <p class="hero-lead">
        Tools and infrastructure published under Konar Technologies and personal repos. AGPL/MIT/Apache where it makes sense.
      </p>
    </section>

    <!-- ── OSS ITEMS ────────────────────────────────────────────────── -->
    <div class="oss-list">

      <!-- Lovely-Logs -->
      <div class="oss-item reveal-item">
        <div class="oss-header">
          <div class="oss-idx">01</div>
          <div class="oss-meta">
            <div class="oss-name-row">
              <span class="oss-name">Lovely-Logs</span>
              <span class="oss-org">lyricalstring</span>
            </div>
            <div class="oss-badges">
              <span class="badge">MIT</span>
              <span class="badge">TypeScript</span>
              <span class="badge">8 ★</span>
            </div>
          </div>
          <div class="oss-links">
            <Link href="https://github.com/lyricalstring/lovely-logs" class="oss-link">github ↗</Link>
            <Link href="https://www.npmjs.com/package/lovely-logs" class="oss-link">npm ↗</Link>
          </div>
        </div>
        <p class="oss-desc">
          Type-safe logging library with automatic environment detection: Node.js, browser, and AWS Lambda. Zero dependencies. Picks the right transport and format for your runtime without configuration.
        </p>
        <div class="oss-install">
          <div class="install-label">INSTALL</div>
          <div class="install-cmds">
            <code>npm install lovely-logs</code>
          </div>
        </div>
      </div>

      <!-- Ley Abierta engine -->
      <div class="oss-item reveal-item">
        <div class="oss-header">
          <div class="oss-idx">02</div>
          <div class="oss-meta">
            <div class="oss-name-row">
              <span class="oss-name">Ley Abierta</span>
              <span class="oss-org">lyricalstring</span>
            </div>
            <div class="oss-badges">
              <span class="badge">AGPL-3.0</span>
              <span class="badge">TypeScript · C</span>
            </div>
          </div>
          <div class="oss-links">
            <Link href="https://github.com/lyricalstring/ley-abierta" class="oss-link">github ↗</Link>
            <Link href="/cases/leyabierta" class="oss-link">→ case study</Link>
          </div>
        </div>
        <p class="oss-desc">
          190 years of Spanish legislation as a public Git repository: {laws} laws, {commits} commits dated to their official publication dates. Includes the hybrid BM25 + RAG retrieval engine with a custom int8 SIMD C kernel: Recall@5 from 2% to 66% on real citizen queries, median latency from ~120s to sub-second. Live at <Link href="https://leyabierta.es" class="inline-link">leyabierta.es ↗</Link>.
        </p>
      </div>

      <!-- Node-Discord-Bot -->
      <div class="oss-item reveal-item">
        <div class="oss-header">
          <div class="oss-idx">03</div>
          <div class="oss-meta">
            <div class="oss-name-row">
              <span class="oss-name">Node-Discord-Bot</span>
              <span class="oss-org">lyricalstring</span>
            </div>
            <div class="oss-badges">
              <span class="badge">MIT</span>
              <span class="badge">TypeScript</span>
              <span class="badge">140 ★ · 92 forks · 3M users · 28k servers</span>
            </div>
          </div>
          <div class="oss-links">
            <Link href="https://github.com/lyricalstring/Node-Discord-Bot" class="oss-link">github ↗</Link>
          </div>
        </div>
        <p class="oss-desc">
          OSS Discord bot framework and template. 140 stars, 92 forks, 3M users across 28k servers. Picked up by the community and running without much maintenance from me.
        </p>
        <div class="oss-install">
          <div class="install-label">INSTALL</div>
          <div class="install-cmds">
            <code>git clone https://github.com/lyricalstring/Node-Discord-Bot</code>
          </div>
        </div>
      </div>

      <!-- ord-rs / Bitcoin contrib -->
      <div class="oss-item reveal-item">
        <div class="oss-header">
          <div class="oss-idx">04</div>
          <div class="oss-meta">
            <div class="oss-name-row">
              <span class="oss-name">ord-rs &amp; Bitcoin tooling</span>
              <span class="oss-org">contrib</span>
            </div>
            <div class="oss-badges">
              <span class="badge">MIT / Apache-2.0</span>
              <span class="badge">Rust</span>
            </div>
          </div>
          <div class="oss-links">
            <Link href="https://github.com/lyricalstring" class="oss-link">github ↗</Link>
          </div>
        </div>
        <p class="oss-desc">
          Contributions to ord-rs (Rust Ordinals library) and related Bitcoin protocol tooling used in Satstream's indexing pipeline. Working familiarity with btcd (Go Bitcoin node) and Bitcoin script internals from building the Runestone decoder microservice.
        </p>
      </div>

    </div>

    <!-- ── FOOTER ────────────────────────────────────────────────────── -->
    <footer class="footer">
      <span class="footer-left">alejandro martinez · @lyricalstring · oss under konar technologies</span>
      <span class="footer-links">
        <Link href="https://github.com/lyricalstring">github</Link>
        <Link href="https://www.linkedin.com/in/lyricalstring/">linkedin</Link>
        <Link href="https://x.com/lyricalstring">x</Link>
        <Link href="mailto:alex@konar.es">email →</Link>
      </span>
    </footer>

  </div>

</Base>


<style>
  .page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 32px 56px;
    box-sizing: border-box;
  }

  /* ── TOP BAR ── */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 12px;
    padding-bottom: 24px;
  }

  .nav {
    display: flex;
    gap: 28px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* ── HERO ── */
  .hero {
    padding-top: 64px;
    padding-bottom: 48px;
    border-top: 1px solid var(--rule);
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }

  .hero-h1 {
    font-family: var(--font-sans);
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .hero-lead {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--dim);
    margin: 0;
    max-width: 680px;
    line-height: 1.55;
  }

  /* ── OSS LIST ── */
  .oss-list {
    margin-top: 48px;
  }

  .oss-item reveal-item {
    padding: 32px 0;
    border-top: 1px solid var(--rule);
  }

  .oss-header {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 0 16px;
    align-items: start;
    margin-bottom: 16px;
  }

  .oss-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    padding-top: 4px;
  }

  .oss-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .oss-name-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .oss-name {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .oss-org {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .oss-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--faint);
    border: 1px solid var(--rule);
    padding: 2px 6px;
    letter-spacing: 0.04em;
  }

  .oss-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .oss-link {
    color: var(--dim);
    text-decoration: none;
  }

  .oss-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--dim);
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: 760px;
    padding-left: 52px;
  }

  .inline-link {
    color: var(--dim);
    text-decoration: none;
  }

  .oss-install {
    padding-left: 52px;
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .install-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--faint);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .install-cmds {
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-x: auto;
    max-width: 100%;
  }

  .install-cmds code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg);
    background: #101216;
    border: 1px solid var(--rule);
    padding: 4px 10px;
    display: block;
    white-space: nowrap;
  }

  /* ── FOOTER ── */
  .footer {
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .footer-left { color: var(--faint); }

  .footer-links {
    display: flex;
    gap: 24px;
    color: var(--dim);
  }

  @media (max-width: 768px) {
    .page {
      padding-inline: 20px;
    }

    .oss-header {
      grid-template-columns: 36px 1fr;
      grid-template-rows: auto auto;
    }

    .oss-links {
      grid-column: 2;
      align-items: flex-start;
      flex-direction: row;
      gap: 12px;
    }

    .oss-desc {
      padding-left: 0;
    }

    .oss-install {
      padding-left: 0;
      flex-direction: column;
      gap: 8px;
    }

    .footer {
      flex-direction: column;
      gap: 16px;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>
