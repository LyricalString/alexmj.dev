---
import Brand from "../components/Brand.astro";
import EmailLink from "../components/EmailLink.astro";
import Link from "../components/Link.astro";
import Pulse from "../components/Pulse.astro";
import Base from "../layouts/Base.astro";
import { getLeyAbiertaStats } from "../lib/leyabierta-stats";

const { laws } = await getLeyAbiertaStats();

const systems = [
  {
    href: "/cases/trilo",
    name: "Trilo",
    years: "2025 — now",
    role: "sole engineer",
    blurb:
      "AI coworkers that edit the same doc you're in. Web, iOS, Android and desktop, plus a 77-tool MCP server in Anthropic's registry.",
    pipeline: ["web · ios · android · desktop", "one backend", "mcp · 77 tools"],
  },
  {
    href: "/cases/satstream",
    name: "Satstream",
    years: "2024 — 2025",
    role: "sole engineer",
    blurb:
      "Bitcoin indexing API. The full chain, ~3 TB, in MongoDB, ScyllaDB, Postgres and Redis for sub-second queries. 8 repos.",
    pipeline: ["bitcoin node", "4 indexers", "api", "5-language sdk"],
  },
  {
    href: "/cases/crossflow",
    name: "Crossflow Network",
    years: "2023 — 2024",
    role: "sole engineer",
    blurb:
      "Cross-chain loans where no single node ever holds the signing key. Threshold signatures on a custom Cosmos SDK L1.",
    pipeline: ["btc · evm · solana", "tss attesters", "cosmos l1"],
  },
  {
    href: "/cases/leyabierta",
    name: "Ley Abierta",
    years: "2026",
    role: "sole author",
    blurb: `190 years of Spanish law as a Git repo, one commit per BOE publication. Search on a custom SIMD C kernel.`,
    pipeline: ["boe", "git", "bm25 + int8 vectors", "api"],
  },
  {
    href: "/cases/asset-reality",
    name: "Asset Reality",
    years: "2022 — 2024",
    role: "primary author",
    blurb:
      "Withdrawal approvals and chain monitoring for a crypto custody platform used by law enforcement.",
    pipeline: ["seizure", "custody", "multi-agency approval", "release"],
  },
  {
    href: "/cases/autowealth",
    name: "Autowealth + CompoundFox",
    years: "2025 — now",
    role: "sole engineer",
    blurb: "A live trading strategy with a public track record, updated daily.",
    pipeline: ["bybit", "strategy", "daily public dashboard"],
  },
  {
    href: "/projects",
    name: "Operations software",
    years: "2021 — now",
    role: "sole engineer",
    blurb:
      "Custom, ERP-style systems for industrial SMEs: orders, repairs, stock and invoicing in one place, so every job has an owner, a status and a paper trail.",
    pipeline: ["order", "job", "invoice"],
  },
  {
    href: "/cases/copy-trader",
    name: "Copy Trader",
    years: "2024 — 2026",
    role: "sole engineer",
    blurb: "Rust copy-trading engine. Copy cycle down from 20s to 4s with parallel order dispatch.",
    pipeline: ["master ws", "position cache", "parallel orders"],
  },
];

const aiSystems = [
  {
    status: "in production",
    name: "Document extraction",
    blurb:
      "Utility invoices and emissions reports turned into validated JSON for a compliance platform. A self-hosted 8B vision model gets 99.2% of invoice fields right (132 of 133) in 1–2 s per document; measurement tables come out 100% correct from native PDFs. A new document type is a config file, not code.",
    pipeline: ["pdf", "text or ocr", "llm · json schema", "validators"],
  },
  {
    status: "in production",
    name: "Meeting transcription",
    blurb:
      "Speech-to-text on the company's own hardware, so recordings never leave the building. 5.2× real time on CPU, speaker diarization, and a glossary pulled from the ERP so internal jargon comes out right.",
    pipeline: ["audio", "whisper", "alignment", "speakers"],
  },
  {
    status: "in production",
    name: "Operations assistants",
    blurb:
      "Supplier purchase orders and payment receipts read from PDFs through an EU-only LLM endpoint. A WhatsApp assistant looks up orders with tool calls, and a person approves every draft before it goes out.",
    pipeline: ["pdf", "docling", "llm", "schema check"],
  },
  {
    status: "live",
    name: "Legal retrieval",
    blurb:
      "Hybrid BM25 and vector search over Spanish law with reranking and citation checks, scored on 678 questions (recall@10 0.76). Qwen3-Embedding-8B fine-tuned with QLoRA on hard negatives filtered by an LLM judge.",
    pipeline: ["query", "bm25 + vectors", "rerank", "cited answer"],
  },
  {
    status: "built",
    name: "Visual inspection",
    blurb:
      "Defect detection trained only on good parts, exported to ONNX for edge devices. AUROC ≥ 0.99 on 7 of 12 categories of public industrial benchmarks.",
    pipeline: ["camera", "patchcore", "heatmap", "defect class"],
  },
];

const telemetry = [
  { label: "ley abierta", value: laws, sub: "laws as git · 190 years · 18 jurisdictions" },
  { label: "satstream", value: "1B+", sub: "bitcoin transactions indexed · ~3 TB" },
  { label: "autowealth", value: "+4.89%", sub: "avg monthly since nov 2025 · public dashboard ↗", href: "https://stats.autowealth.trade/dashboard/aw-core/4be06b25" },
  { label: "asset reality", value: "$500M", sub: "custody aum, from $200M in my 19 months" },
  { label: "discord bot", value: "3M", sub: "users · 28k servers · 140★" },
];
---

<Base
  title="Alejandro Martínez — Software Engineer"
  description="Production systems across AI, Bitcoin infrastructure, DeFi protocols and full-stack SaaS."
>
  <div class="page">

    <!-- ── TOP BAR ──────────────────────────────────────────────────── -->
    <header class="topbar">
      <Brand />
      <nav class="nav">
        <Link href="#systems">systems</Link>
        <Link href="/about">about</Link>
        <Link href="/oss">oss</Link>
        <Link href="/cv">cv</Link>
      </nav>
      <Link href="#contact" class="status-link">
        <Pulse color="var(--accent)" />
        <span>available</span>
      </Link>
    </header>

    <!-- ── HERO ─────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="whoami-line">software engineer · valencia · remote · en / es</div>

      <div class="hero-grid">
        <h1 class="hero-h1">
          End-to-end production systems
          <em>across AI, Bitcoin infrastructure, DeFi and <span class="nowrap">full-stack</span> SaaS.</em>
        </h1>

        <div class="hero-meta">
          <p class="hero-note">Sole engineer on seven of the eight systems below, plus the AI systems behind them.</p>
          <div class="hero-links">
            <a href="#systems" class="line-link"><span>see the systems</span><span class="arrow">↓</span></a>
            <EmailLink class="line-link line-link-last" withArrow />
          </div>
          <div class="hero-avail">full-time · freelance · consulting</div>
        </div>
      </div>
    </section>

    <!-- ── TELEMETRY ────────────────────────────────────────────────── -->
    <section class="stats-strip" aria-label="Production figures">
      <div class="tele-head">
        <span>running in production</span>
        <span class="tele-live"><span class="live-dot"></span>live</span>
      </div>
      <div class="tele-grid">
        {telemetry.map((t) => {
          const Tag = t.href ? "a" : "div";
          return (
            <Tag class:list={["tele-cell", t.href && "tele-link"]} href={t.href} target={t.href && "_blank"} rel={t.href && "noopener"}>
              <span class="tele-label">{t.label}</span>
              <span class="tele-value">{t.value}</span>
              <span class="tele-sub">{t.sub}</span>
            </Tag>
          );
        })}
      </div>
    </section>

    <!-- ── SYSTEMS ──────────────────────────────────────────────────── -->
    <section id="systems" class="systems reveal-section">
      <div class="section-head">
        <h2 class="section-h2">Systems</h2>
        <span class="section-meta">2021 — 2026 · 08</span>
      </div>

      <div class="sys-list">
        {systems.map((s, i) => (
          <a href={s.href} class="sys reveal-item">
            <span class="sys-idx">{String(i + 1).padStart(2, "0")}<span class="sys-years"><span class="sys-dot"> · </span>{s.years}</span></span>
            <span class="sys-name">{s.name}</span>
            <span class="sys-blurb">{s.blurb}</span>
            <span class="sys-pipe">
              {s.pipeline.map((step, j) => (
                <>{j > 0 && <b> → </b>}<span class="nowrap">{step}</span></>
              ))}
            </span>
            <span class="sys-role">{s.role}</span>
            <span class="sys-cta">read the case →</span>
          </a>
        ))}
      </div>

      <div class="also">
        <span class="also-label">also</span>
        <span class="also-body">
          LEB, events platform for expats in Bali · Node-Discord-Bot, 3M users · Lovely-Logs, typed
          logging library
        </span>
        <Link href="/projects" class="also-link">all projects →</Link>
      </div>
    </section>

    <!-- ── AI SYSTEMS ───────────────────────────────────────────────── -->
    <section id="ai" class="ai reveal-section">
      <div class="section-head">
        <h2 class="section-h2">AI systems</h2>
        <span class="section-meta">self-hosted where the data can't leave</span>
      </div>
      <p class="ai-lead">
        Applied AI inside the systems above and for clients: extraction, speech, retrieval and vision,
        measured against hand-checked answers before anything ships.
      </p>
      <div class="ai-grid">
        {aiSystems.map((a) => (
          <div class="ai-card reveal-item">
            <span class:list={["ai-status", a.status !== "built" && "ai-status--live"]}>{a.status}</span>
            <span class="ai-name">{a.name}</span>
            <span class="ai-blurb">{a.blurb}</span>
            <span class="sys-pipe">
              {a.pipeline.map((step, j) => (
                <>{j > 0 && <b> → </b>}<span class="nowrap">{step}</span></>
              ))}
            </span>
          </div>
        ))}
      </div>
      <p class="ai-also">
        Also: vision-model bake-offs across Qwen, Gemma and Mistral; ModernBERT fine-tunes for issue
        triage; coding-agent orchestration with isolated worktrees.
      </p>
    </section>

    <!-- ── CONSULTING + CONTACT ─────────────────────────────────────── -->
    <section id="contact" class="closing">
      <div class="consult reveal-section">
        <div class="reveal-item">
          <span class="consult-label">consulting</span>
          <p class="consult-text">Bring a technical problem. I scope it and lay out the options and their tradeoffs.</p>
          <EmailLink class="consult-link" withArrow />
        </div>
      </div>

      <div class="contact">
        <span class="contact-label">contact</span>
        <p class="contact-lead">Open to full-time roles, freelance and consulting.</p>
        <EmailLink class="contact-email" />
        <div class="contact-channels">
          <Link href="https://github.com/lyricalstring" class="line-link"><span class="key">github</span><span>lyricalstring ↗</span></Link>
          <Link href="https://www.linkedin.com/in/lyricalstring/" class="line-link"><span class="key">linkedin</span><span>lyricalstring ↗</span></Link>
          <Link href="https://x.com/lyricalstring" class="line-link"><span class="key">x</span><span>@lyricalstring ↗</span></Link>
          <a href="/cv.pdf" class="line-link line-link-last"><span class="key">cv</span><span>pdf ↓</span></a>
        </div>
      </div>
    </section>

    <!-- ── FOOTER ────────────────────────────────────────────────────── -->
    <footer class="footer">
      <span class="footer-left">alejandro martínez · @lyricalstring</span>
      <span class="footer-links">
        <Link href="/about">about</Link>
        <Link href="/cv">cv</Link>
        <Link href="/projects">projects</Link>
        <Link href="/oss">oss</Link>
      </span>
    </footer>

  </div>
</Base>

<style>
  /* ── PAGE ─────────────────────────────────────────────────────────── */
  .page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }

  .nowrap {
    white-space: nowrap;
  }

  /* ── TOP BAR ──────────────────────────────────────────────────────── */
  .topbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    row-gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .nav {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    gap: 22px;
    color: var(--dim);
  }

  .nav :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--dim);
  }

  .topbar :global(.status-link) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── HERO ─────────────────────────────────────────────────────────── */
  .hero {
    padding: 56px 0 40px;
  }

  .whoami-line {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 28px;
  }

  .hero-h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 7.4vw + 0.5rem, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .hero-h1 em {
    color: var(--dim);
  }

  .hero-meta {
    margin-top: 36px;
  }

  .hero-note {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .hero-avail {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
  }

  /* Full-width link rows: label left, arrow right. Used across the page. */
  .line-link,
  :global(.line-link) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    text-decoration: none;
    transition: color 120ms ease;
  }

  :global(.line-link-last) {
    border-bottom: 1px solid var(--rule);
  }

  .line-link .arrow {
    color: var(--accent);
  }

  :global(.line-link .key) {
    color: var(--dim);
  }

  @media (hover: hover) {
    .line-link:hover,
    :global(.line-link:hover) {
      color: var(--accent);
    }
  }

  /* ── TELEMETRY ───────────────────────────────────────────────────── */
  .stats-strip {
    border: 1px solid var(--rule);
    background: var(--panel);
    padding: 16px 16px 4px;
  }

  .tele-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--dim);
  }

  .tele-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tele-cell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 12px;
    row-gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
  }

  .tele-link {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .tele-link:hover .tele-value,
    .tele-link:hover .tele-sub {
      color: var(--accent);
    }
  }

  .tele-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
  }

  .tele-value {
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .tele-sub {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  /* ── SYSTEMS ─────────────────────────────────────────────────────── */
  /* Major sections share one boundary: a hairline, fixed space above and below. */
  .systems,
  .ai,
  .closing {
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--rule-strong);
  }

  /* Mobile: title on its own line, meta below. Side by side from 768px. */
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 8px;
  }

  .section-h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 44px;
    line-height: 1;
  }

  .section-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
  }

  .sys {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    row-gap: 14px;
    column-gap: 12px;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }

  .sys-idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    align-self: center;
  }

  .sys-role {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 11px;
    border: 1px solid var(--rule-strong);
    padding: 4px 8px;
    white-space: nowrap;
  }

  .sys-name,
  .sys-blurb,
  .sys-pipe,
  .sys-cta {
    grid-column: 1 / -1;
  }

  .sys-name {
    font-family: var(--font-serif);
    font-size: 38px;
    line-height: 1;
    transition: color 120ms ease;
  }

  .sys-blurb {
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .sys-pipe {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    color: var(--dim);
    background: var(--panel);
    border: 1px solid var(--rule);
    padding: 10px 12px;
  }

  .sys-pipe b {
    font-weight: 400;
    color: var(--accent);
  }

  .sys-cta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  @media (hover: hover) {
    .sys:hover .sys-name {
      color: var(--accent);
    }
  }

  .also {
    display: grid;
    gap: 8px;
    padding: 24px 0 0;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.6;
    color: var(--dim);
  }

  .also-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .also :global(.also-link) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  /* ── AI SYSTEMS ──────────────────────────────────────────────────── */
  .ai-lead {
    margin: 12px 0 8px;
    max-width: 640px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .ai-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }

  .ai-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
  }

  .ai-status--live {
    color: var(--accent);
  }

  .ai-status--live::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .ai-name {
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1;
  }

  .ai-blurb {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .ai .sys-pipe {
    align-self: stretch;
  }

  .ai-also {
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.6;
    color: var(--dim);
  }

  /* ── CONSULTING + CONTACT ────────────────────────────────────────── */
  .closing {
    display: grid;
    gap: 72px;
  }

  .consult {
    padding: 28px 20px;
    background: var(--fg);
    color: var(--bg);
  }

  .consult-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #4a4843;
  }

  .consult-text {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1.05;
  }

  .consult :global(.consult-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--bg);
    text-decoration: none;
    border-bottom: 1px solid var(--bg);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
  }

  .contact-lead {
    margin: 14px 0 0;
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1;
  }

  .contact :global(.contact-email) {
    display: block;
    margin-top: 28px;
    padding-bottom: 12px;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw + 0.5rem, 4rem);
    line-height: 1.1;
    color: var(--accent);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-channels {
    margin-top: 24px;
  }

  /* ── FOOTER ──────────────────────────────────────────────────────── */
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .footer-links {
    display: flex;
    gap: 18px;
  }

  .footer-links :global(a) {
    color: var(--faint);
  }

  /* ── ≥ 768px ─────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .page {
      padding: 0 48px 56px;
    }

    .topbar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 40px;
      padding: 18px 0;
    }

    .nav {
      grid-column: 2;
      grid-row: 1;
      gap: 32px;
    }

    .tele-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }

    .consult {
