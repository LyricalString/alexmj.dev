---
import Brand from "../components/Brand.astro";
import EmailLink from "../components/EmailLink.astro";
import Link from "../components/Link.astro";
import Pulse from "../components/Pulse.astro";
import Base from "../layouts/Base.astro";
import { getLeyAbiertaStats } from "../lib/leyabierta-stats";

const { laws, commits } = await getLeyAbiertaStats();
---

<Base
  title="Alejandro Martínez — Software Engineer"
  description="Software engineer. Sole engineer behind a Bitcoin indexer, an AI workspace and 190 years of Spanish law as Git."
>
  <div class="page">

    <!-- ── TOP BAR ──────────────────────────────────────────────────── -->
    <header class="topbar">
      <Brand />
      <nav class="nav">
        <Link href="/projects">projects</Link>
        <Link href="/about">about</Link>
        <Link href="/oss">oss</Link>
        <Link href="/cv">cv</Link>
      </nav>
    </header>

    <!-- ── HERO BLOCK ────────────────────────────────────────────────── -->
    <section class="hero">

      <!-- whoami response line -->
      <div class="whoami-line">
        <div class="whoami-left">
          <span class="chevron">&gt;</span>
          <span class="name">alejandro martinez</span>
          <span class="sep">·</span>
          <span class="role">software engineer</span>
          <span class="sep">·</span>
          <span class="city">valencia</span>
        </div>
        <Link href="#contact" class="status-link">
          <span class="status-inner">
            <Pulse color="var(--accent)" />
            <span class="status-text">available now</span>
            <span class="status-arrow">↗</span>
          </span>
        </Link>
      </div>

      <!-- H1 -->
      <h1 class="hero-h1">
        Sole engineer behind a <span class="dim">Bitcoin indexer</span>, an <span class="dim">AI workspace</span>
        and <span class="dim">190 years of Spanish law</span> as Git.
      </h1>

      <!-- meta sub-line -->
      <div class="hero-meta">
        <span>en · es</span>
        <span>remote</span>
        <span>full-time + select freelance</span>
      </div>

      <!-- numbers strip -->
      <div class="stats-strip reveal-section">
        <div class="stat reveal-item">
          <div class="stat-label">bitcoin chain</div>
          <div class="stat-value">1B+</div>
          <div class="stat-sub">transactions indexed · ~3 TB · 8 repos</div>
        </div>
        <div class="stat reveal-item">
          <div class="stat-label">laws indexed</div>
          <div class="stat-value">{laws}</div>
          <div class="stat-sub">190 years · 484K embeddings · 18 jurisdictions</div>
        </div>
        <div class="stat reveal-item">
          <div class="stat-label">sharpe (live)</div>
          <div class="stat-value">5.60</div>
          <div class="stat-sub">+56% roi · since nov 2025 · public dashboard</div>
        </div>
        <div class="stat reveal-item">
          <div class="stat-label">discord users</div>
          <div class="stat-value">3M</div>
          <div class="stat-sub">28k servers · 140★  · 92 forks</div>
        </div>
        <div class="stat reveal-item">
          <div class="stat-label">custody aum</div>
          <div class="stat-value">$200M → $500M</div>
          <div class="stat-sub">platform aum during my 19 months · primary author of 2 core services</div>
        </div>
      </div>
    </section>

    <!-- ── SELECTED WORK ─────────────────────────────────────────────── -->
    <section id="work" class="work-section">
      <div class="work-label">
        SELECTED WORK<br>
        <span>2022 — 2026</span>
      </div>
      <div class="work-rows">

        <a href="/cases/trilo" class="work-row">
          <div class="row-idx">01</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Trilo</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              AI workspace where AI coworkers edit docs alongside people and run multi-step workflows.
              Web, iOS, Android and desktop, a Python transcription agent, and a 77-tool MCP server
              published in Anthropic's registry. Live at trilo.chat.
            </p>
            <div class="row-stack">TypeScript&nbsp;&nbsp;·&nbsp; Rust&nbsp;&nbsp;·&nbsp; Python&nbsp;&nbsp;·&nbsp; Bun · Elysia&nbsp;&nbsp;·&nbsp; Supabase&nbsp;&nbsp;·&nbsp; Tauri&nbsp;&nbsp;·&nbsp; MCP</div>
          </div>
          <div class="row-year">2025 — now</div>
        </a>

        <a href="/cases/satstream" class="work-row">
          <div class="row-idx">02</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Satstream</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              Bitcoin indexing API. Sole engineer across 8 repos, from the indexers and a 5-language SDK
              to the block explorer and AWS infra. Indexes the full chain (~3 TB) into MongoDB, ScyllaDB,
              Postgres and Redis for sub-second queries.
            </p>
            <div class="row-stack">Rust&nbsp;&nbsp;·&nbsp; Go&nbsp;&nbsp;·&nbsp; Python&nbsp;&nbsp;·&nbsp; ScyllaDB&nbsp;&nbsp;·&nbsp; MongoDB&nbsp;&nbsp;·&nbsp; gRPC&nbsp;&nbsp;·&nbsp; AWS CDK</div>
          </div>
          <div class="row-year">2024 — 2025</div>
        </a>

        <a href="/cases/crossflow" class="work-row">
          <div class="row-idx">03</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Crossflow Network</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              Cross-chain loan protocol on a custom Cosmos SDK L1. Instead of a trusted multisig, a quorum
              of attesters co-signs Bitcoin, EVM and Solana transactions with threshold signatures, and no
              single node ever holds the full key. Sole engineer at Hexmount.
            </p>
            <div class="row-stack">Go&nbsp;&nbsp;·&nbsp; Cosmos SDK&nbsp;&nbsp;·&nbsp; CometBFT&nbsp;&nbsp;·&nbsp; TSS/MPC-ECDSA&nbsp;&nbsp;·&nbsp; secp256k1 + ed25519&nbsp;&nbsp;·&nbsp; IBC</div>
          </div>
          <div class="row-year">2023 — 2024</div>
        </a>

        <a href="/cases/leyabierta" class="work-row">
          <div class="row-idx">04</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Ley Abierta</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              {laws} Spanish laws since 1835 as a Git repo, {commits} commits dated to their official
              publication. Search combines BM25 with int8 vector search on a hand-written SIMD C kernel
              (index 7.6 GB → 1.4 GB), with Qwen models on an EU no-log provider. Live at leyabierta.es.
            </p>
            <div class="row-stack">TypeScript · Bun&nbsp;&nbsp;·&nbsp; SQLite + FTS5&nbsp;&nbsp;·&nbsp; C SIMD&nbsp;&nbsp;·&nbsp; Qwen (EU, no-log)&nbsp;&nbsp;·&nbsp; AGPL-3.0</div>
          </div>
          <div class="row-year">2026</div>
        </a>

        <a href="/cases/asset-reality" class="work-row">
          <div class="row-idx">05</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Asset Reality</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              19 months at a crypto custody platform used by law enforcement. Primary author of the
              multi-sig withdrawal-approval engine and the chain-ingestion service. Platform AUM went
              from $200M to $500M while I was there ($1B+ today).
            </p>
            <div class="row-stack">Go&nbsp;&nbsp;·&nbsp; TypeScript&nbsp;&nbsp;·&nbsp; MongoDB&nbsp;&nbsp;·&nbsp; Postgres&nbsp;&nbsp;·&nbsp; RabbitMQ&nbsp;&nbsp;·&nbsp; AWS · Terraform&nbsp;&nbsp;·&nbsp; Fireblocks</div>
          </div>
          <div class="row-year">2022 — 2024</div>
        </a>

        <a href="/cases/autowealth" class="work-row">
          <div class="row-idx">06</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Autowealth + CompoundFox</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              Algorithmic trading platform with a live, public performance dashboard. CompoundFox is the
              flagship strategy, with equity curve, Sharpe and drawdown updated daily. Autowealth is the
              SaaS that distributes it: backend, Telegram bot, dashboards and mobile app in one Turborepo,
              deployed with AWS CDK.
            </p>
            <div class="row-stack">TypeScript&nbsp;&nbsp;·&nbsp; Bun&nbsp;&nbsp;·&nbsp; Python&nbsp;&nbsp;·&nbsp; Jesse&nbsp;&nbsp;·&nbsp; Bybit API&nbsp;&nbsp;·&nbsp; AWS CDK</div>
          </div>
          <div class="row-year">2025 — now</div>
        </a>

        <a href="/cases/copy-trader" class="work-row">
          <div class="row-idx">07</div>
          <div class="row-body">
            <div class="row-title-line">
              <span class="row-name">Copy Trader</span>
              <span class="case-badge">CASE STUDY ↗</span>
            </div>
            <p class="row-blurb">
              Copy trading engine in Rust. Mirrors a master Bybit account to follower accounts on Bybit,
              Binance and Hyperliquid over WebSocket, sizing by position with BigDecimal math and
              idempotent execution.
            </p>
            <div class="row-stack">Rust&nbsp;&nbsp;·&nbsp; Axum&nbsp;&nbsp;·&nbsp; PostgreSQL&nbsp;&nbsp;·&nbsp; AWS CDK&nbsp;&nbsp;·&nbsp; Telegram Bot&nbsp;&nbsp;·&nbsp; Twilio</div>
          </div>
          <div class="row-year">2024 — 2026</div>
        </a>

      </div>
    </section>

    <!-- ── OTHER PROJECTS ────────────────────────────────────────────── -->
    <section class="other-section">
      <div class="other-header">
        <span class="other-label">OTHER PROJECTS · 3</span>
        <Link href="/projects" class="other-view-all">view all →</Link>
      </div>
      <div class="other-grid">

        <div class="other-row">
          <div class="other-idx">08</div>
          <div>
            <div class="other-name">Tecpar</div>
            <div class="other-blurb">b2b saas for an industrial electronics repair workshop (elevator boards) · sole engineer · internal admin, client portal, e-commerce, public site</div>
          </div>
        </div>

        <div class="other-row">
          <div class="other-idx">09</div>
          <div>
            <div class="other-name">LEB</div>
            <div class="other-blurb">expo rn + next admin · events & membership platform for expats in bali · partner discounts, mapbox</div>
          </div>
        </div>

        <div class="other-row">
          <div class="other-idx">10</div>
          <div>
            <div class="other-name">Node-Discord-Bot</div>
            <div class="other-blurb">oss bot · 3M users, 28k servers, 140★, 92 forks</div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── CONTACT ───────────────────────────────────────────────────── -->
    <section id="contact" class="contact-section">
      <div class="contact-grid">
        <div class="contact-label">CONTACT</div>
        <div class="contact-body">
          <p class="contact-lead">
            Open to full-time roles and select freelance now.<br>
            Best reached by email. I read every message.
          </p>
          <EmailLink class="contact-email" withArrow />
          <div class="contact-channels">
            <Link href="https://github.com/lyricalstring" class="contact-channel">
              <span class="channel-key">github</span>
              <span class="channel-handle">github.com/lyricalstring</span>
              <span class="channel-arrow">↗</span>
            </Link>
            <Link href="https://www.linkedin.com/in/lyricalstring/" class="contact-channel">
              <span class="channel-key">linkedin</span>
              <span class="channel-handle">linkedin.com/in/lyricalstring</span>
              <span class="channel-arrow">↗</span>
            </Link>
            <Link href="https://x.com/lyricalstring" class="contact-channel">
              <span class="channel-key">x</span>
              <span class="channel-handle">@lyricalstring</span>
              <span class="channel-arrow">↗</span>
            </Link>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FOOTER ────────────────────────────────────────────────────── -->
    <footer class="footer">
      <span class="footer-left">alejandro martinez · @lyricalstring · oss under konar technologies</span>
      <span class="footer-links">
        <Link href="/about">about</Link>
        <Link href="/cv">cv</Link>
        <Link href="/projects">projects</Link>
        <Link href="/oss">oss</Link>
      </span>
    </footer>

  </div>

</Base>


<style>
  /* ── PAGE WRAPPER ─────────────────────────────────────────────────── */
  .page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 32px 56px;
    box-sizing: border-box;
  }

  /* ── TOP BAR ──────────────────────────────────────────────────────── */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 12px;
    padding-bottom: 24px;
  }

  .nav {
    display: flex;
    gap: 28px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* ── HERO BLOCK ───────────────────────────────────────────────────── */
  .hero {
    padding-top: 88px;
    padding-bottom: 64px;
    border-top: 1px solid var(--rule);
  }

  /* whoami response line */
  .whoami-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 13px;
    gap: 12px;
  }

  .whoami-left {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .chevron { color: var(--faint); }
  .name { color: var(--fg); font-weight: 500; }
  .role { color: var(--dim); }
  .city { color: var(--dim); }
  .sep { color: var(--faint); }

  /* status pill */
  .status-link {
    color: var(--fg);
    text-decoration: none;
    transition: opacity 120ms ease;
    padding: 4px 0;
    flex-shrink: 0;
  }

  .status-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    max-width: calc(100vw - 2rem);
    overflow: hidden;
  }

  .status-text {
    color: var(--fg);
    white-space: nowrap;
  }

  .status-arrow {
    color: var(--accent);
    transition: transform 120ms ease;
  }

  @media (hover: hover) {
    .status-link:hover .status-arrow {
      transform: translate(2px, -2px);
    }

    .status-link:hover {
      color: var(--fg);
    }
  }

  /* H1 */
  .hero-h1 {
    font-family: var(--font-sans);
    font-size: var(--text-hero-home);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 36px 0 0;
    max-width: 920px;
  }

  .dim { color: var(--dim); }

  /* meta sub-line */
  .hero-meta {
    display: flex;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* numbers strip */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 32px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.06em;
  }

  .stat-value {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 4px;
    word-break: break-word;
  }

  .stat-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    margin-top: 4px;
  }

  /* ── SELECTED WORK ────────────────────────────────────────────────── */
  .work-section {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0;
    padding-top: 16px;
  }

  .work-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
    position: sticky;
    top: 24px;
    align-self: start;
  }

  .work-label span {
    color: var(--faint);
  }

  .work-rows {
    overflow: hidden;
  }

  .work-row {
    display: grid;
    grid-template-columns: 44px 1fr 80px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease;
    /* CSS fallback: visible when GSAP hasn't run or reduced-motion is on */
    opacity: 1;
  }

  @media (hover: hover) {
    .work-row:hover {
      background: rgba(255, 255, 255, 0.015);
    }

    .work-row:hover .row-name { color: var(--accent); }
    .work-row:hover .case-badge { color: var(--accent); border-color: var(--dim); }
  }

  .row-idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .row-title-line {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .row-name {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .case-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--dim);
    letter-spacing: 0.08em;
    border: 1px solid var(--rule);
    padding: 2px 6px;
  }

  .row-blurb {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--dim);
    margin: 8px 0 0;
    max-width: 640px;
    line-height: 1.55;
  }

  .row-stack {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    margin-top: 12px;
    letter-spacing: 0.02em;
  }

  .row-year {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    text-align: right;
  }

  /* ── OTHER PROJECTS ───────────────────────────────────────────────── */
  .other-section {
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .other-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 28px;
  }

  .other-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .other-view-all {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 56px;
  }

  .other-row {
    display: grid;
    grid-template-columns: 32px 1fr;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease;
  }

  @media (hover: hover) {
    a.other-row:hover {
      background: rgba(255, 255, 255, 0.015);
    }

    a.other-row:hover .other-name { color: var(--accent); }
  }

  .other-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .other-name {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
  }

  .other-blurb {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--dim);
    margin-top: 4px;
  }

  /* ── CONTACT ──────────────────────────────────────────────────────── */
  .contact-section {
    margin-top: 96px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 24px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .contact-body {
    max-width: 720px;
  }

  .contact-lead {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--fg);
    margin: 0 0 28px;
  }

  .contact-email {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--accent);
    text-decoration: none;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 28px;
    letter-spacing: -0.01em;
    width: 100%;
    box-sizing: border-box;
    transition: opacity 120ms ease;
  }

  @media (hover: hover) {
    .contact-email:hover {
      opacity: 0.7;
    }
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
  }

  .contact-channel {
    display: grid;
    grid-template-columns: 110px 1fr 24px;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dim);
    text-decoration: none;
    transition: color 120ms ease;
  }

  @media (hover: hover) {
    .contact-channel:hover {
      color: var(--fg);
    }
  }

  .channel-key {
    color: var(--faint);
    letter-spacing: 0.06em;
    font-size: 11px;
  }

  .channel-handle {
    color: var(--fg);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .channel-arrow {
    color: var(--accent);
    text-align: right;
  }

  /* ── FOOTER ───────────────────────────────────────────────────────── */
  .footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .footer-left {
    color: var(--faint);
  }

  .footer-links {
    display: flex;
    gap: 24px;
    color: var(--dim);
  }

  /* ── REVEAL ANIMATIONS ──────────────────────────────────────────── */
  .reveal-section {
    overflow: hidden;
  }

  .reveal-item {
    opacity: 0;
  }

  /* ── RESPONSIVE — ≤768px (tablet portrait + mobile) ────────────────── */
  @media (max-width: 767px) {
    .page {
      padding: 20px 16px 40px;
    }

    /* Nav: stack brand + nav on separate lines */
