---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Alejandro Martínez — software engineer building reliable backend systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- OG / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://alexmj.dev" />
    <meta property="og:image" content="https://alexmj.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Geist + Geist Mono via Google Fonts — weights 400 & 500 only.
         Non-blocking: preload as style, promote to stylesheet on load. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap" />
    </noscript>

    <!-- GSAP 3.15 + ScrollTrigger via CDN — is:raw prevents Astro/Vite from processing -->
    <script is:raw defer src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
    <script is:raw defer src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>
    <!-- Lenis 1.0.42 via CDN -->
    <script is:raw defer src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {import.meta.env.PROD && (
      <script is:raw defer src="https://analytics.alexmj.dev/ley.js" data-website-id="fbf38663-a8b9-4cec-8f2e-b4c545e5e52a"></script>
    )}

    <!-- Pre-GSAP fallback — hide animated elements before GSAP loads so the
         initial paint doesn't flash visible content at opacity:1 then snap to 0.
         If GSAP fails to load entirely, the 1.5s-delayed animation reveals everything. -->
    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        .whoami-line,
        .hero-h1,
        .hero-meta,
        .hero-tag,
        .hero-lead,
        .hero-links,
        .stats-strip,
        .work-row,
        .reveal-item {
          opacity: 0;
          animation: gsap-fallback 0s linear 1.5s forwards;
        }
        @keyframes gsap-fallback {
          to { opacity: 1; }
        }
      }
    </style>

    <!-- Global responsive chrome — nav + footer shared across all pages -->
    <style is:global>
      /* ── Shared chrome: ≤767px ──────────────────────────────────────── */
      @media (max-width: 767px) {
        /* Page padding */
        .page {
          padding-left: 16px;
          padding-right: 16px;
        }

        /* Nav: stack brand above nav links */
        .topbar {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }

        /* Nav touch targets ≥44px via padding */
        .nav {
          gap: 20px;
        }

        .nav a,
        .nav .link {
          padding: 8px 0;
          min-height: 44px;
          display: inline-flex;
          align-items: center;
        }

        /* Footer: stack vertically */
        .footer {
          flex-direction: column;
          align-items: flex-start;
          gap: 8px;
        }

        .footer-links {
          gap: 16px;
        }
      }

      /* ── Shared chrome: ≤479px ──────────────────────────────────────── */
      @media (max-width: 479px) {
        .page {
          padding-left: 16px;
          padding-right: 16px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>

    <!-- GSAP + Lenis motion system — vanilla JS, no imports -->
    <script is:raw>
      (function() {
        var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", run);
        } else {
          run();
        }

        function run() {
          var gsap = window.gsap;
          var ScrollTrigger = window.ScrollTrigger || gsap.ScrollTrigger;
          var Lenis = window.Lenis;

          if (!gsap || !ScrollTrigger) {
            console.warn("[motion] GSAP or ScrollTrigger not loaded");
            return;
          }

          gsap.registerPlugin(ScrollTrigger);

          if (!prefersReducedMotion && Lenis) {
            var lenis = new Lenis({
              lerp: 0.08,
              duration: 1.2,
              smoothWheel: true,
            });

            // Connect GSAP's ScrollTrigger to Lenis scroll
            lenis.on("scroll", ScrollTrigger.update);

            // Tell GSAP to call Lenis' rAF loop
            gsap.ticker.add(function(time) {
              lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
          }

          // Hero animations (home page)
          if (document.querySelector(".whoami-line")) {
            if (!prefersReducedMotion) {
              var tl = gsap.timeline({ defaults: { ease: "power3.out" } });
              tl.fromTo(".whoami-line", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5 })
                .fromTo(".hero-h1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7 }, "-=0.2")
                .fromTo(".hero-meta", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4 }, "-=0.3")
                .fromTo(".stats-strip", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5 }, "-=0.2");

              // TODO(F1.5/Gate4): work-row reveal may not fire on narrow widths if rows
              // are already partially in-viewport when the page loads and user hasn't
              // scrolled — consider IntersectionObserver fallback or once:true + refreshOnUpdate.
              gsap.fromTo(".work-row", { opacity: 0, y: 20 }, {
                opacity: 1, y: 0, duration: 0.5, stagger: 0.08, ease: "power2.out",
                scrollTrigger: { trigger: ".work-rows", start: "top 95%", toggleActions: "play none none none" }
              });
            } else {
              gsap.set(".whoami-line, .hero-h1, .hero-meta, .stats-strip, .work-row", { opacity: 1, y: 0 });
            }
          }

          // Case study hero animations
          if (document.querySelector(".hero-tag")) {
            if (!prefersReducedMotion) {
              var tl2 = gsap.timeline({ defaults: { ease: "power3.out" } });
              tl2.fromTo(".hero-tag", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4 })
                .fromTo(".hero-meta", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5 }, "-=0.2")
                .fromTo(".hero-h1", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7 }, "-=0.3")
                .fromTo(".hero-lead", { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.5 }, "-=0.3")
                .fromTo(".hero-links", { opacity: 0 }, { opacity: 1, duration: 0.4 }, "-=0.3");
            } else {
              gsap.set(".hero-tag, .hero-meta, .hero-h1, .hero-lead, .hero-links", { opacity: 1, y: 0 });
            }
          }

          // Reveal sections (all pages)
          if (!prefersReducedMotion) {
            document.querySelectorAll(".reveal-section").forEach(function(section) {
              var items = section.querySelectorAll(".reveal-item");
              if (items.length > 0) {
                gsap.fromTo(items, { opacity: 0, y: 24 }, {
                  opacity: 1, y: 0, duration: 0.6, stagger: 0.06, ease: "power3.out",
                  scrollTrigger: { trigger: section, start: "top bottom-=10%", toggleActions: "play none none none" }
                });
              }
            });
          } else {
            gsap.set(".reveal-item", { opacity: 1, y: 0 });
          }

          // Magnetic hover
          if (!prefersReducedMotion) {
            document.querySelectorAll(".work-row, .other-row, .case-badge").forEach(function(el) {
              el.addEventListener("mousemove", function(e) {
                var rect = el.getBoundingClientRect();
                var x = e.clientX - rect.left - rect.width / 2;
                var y = e.clientY - rect.top - rect.height / 2;
                gsap.to(el, { x: x * 0.15, y: y * 0.15, duration: 0.3, ease: "power2.out" });
              });
              el.addEventListener("mouseleave", function() {
                gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: "elastic.out(1, 0.5)" });
              });
            });
          }
        }
      })();
    </script>
  </body>
</html>
